; Godot 4.2 Project File
; Merciful - Crime Saga (Open-Source, MIT License)

config_version=5

[application]
config/name="Merciful"
config/description="Gritty crime saga inspired by The Last of Us, Mafia, Red Dead. Open-source, no copyright."
config/features=PackedStringArray("4.2", "GDScript", "GlT")
config/icon="res://icon.svg"
run/main_scene="res://scenes/main_menu/MainMenu.tscn"

[display]
window/size/viewport_width=3840
window/size/viewport_height=2160
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/content_scale_mode="viewport"
renderer/content_scale_size=Vector2(3840, 2160)
renderer/content_scale_aspect="expand"
textures/canvas_textures/default_texture_filter=0

[physics]
common/physics_ticks_per_second=60
common/max_contacts_reported=10

[input]
move_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"echo":false,"script":null)
]
}
